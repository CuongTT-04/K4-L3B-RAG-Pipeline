# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: local (no key) | mistral | openai | gemini | anthropic
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Embedding: hashing (offline) | sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-384
EMBEDDING_DIM=384

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.18
